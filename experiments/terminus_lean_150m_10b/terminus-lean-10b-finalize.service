[Unit]
Description=Verify Terminus Lean 10B artifacts in Azure Blob, then deallocate H100 (sanitized template)
Wants=network-online.target
After=network-online.target terminus-lean-10b.service
RequiresMountsFor=/var/lib/terminus
StartLimitIntervalSec=0

[Service]
Type=simple
User=terminus
Group=terminus
WorkingDirectory=/opt/terminus-modeltunnelv2
ExecStart=/opt/terminus-venv/bin/python /opt/terminus-modeltunnelv2/experiments/terminus_lean_150m_10b/finalize_blob_and_deallocate.py --run-root /var/lib/terminus/runs/lean_dense_10b_20261001 --blob-url https://your-storage-account.blob.core.windows.net/runs/terminus_lean_150m_10b_run_20261001/ --vm-resource-id /subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/your-resource-group/providers/Microsoft.Compute/virtualMachines/your-vm --train-service terminus-lean-10b.service --ops-log /var/lib/terminus/ops/finalizer.log
Restart=on-failure
RestartSec=300
StandardOutput=append:/var/lib/terminus/ops/finalizer.log
StandardError=append:/var/lib/terminus/ops/finalizer.log

[Install]
WantedBy=multi-user.target
