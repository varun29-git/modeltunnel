[Unit]
Description=Verify Terminus Lean ternary QAT artifacts in S3 and Blob, then deallocate H100 (sanitized template)
Wants=network-online.target
After=network-online.target terminus-lean-qat-2b.service
RequiresMountsFor=/var/lib/terminus
StartLimitIntervalSec=0

[Service]
Type=simple
User=terminus
Group=terminus
WorkingDirectory=/opt/terminus-modeltunnelv2
ExecStart=/opt/terminus-venv/bin/python /opt/terminus-modeltunnelv2/experiments/terminus_lean_150m_qat_2b/finalize_blob_and_deallocate.py --run-root /var/lib/terminus/runs/lean_ternary_qat_2b_20261002 --s3-run-uri s3://your-run-artifact-bucket/terminus_lean_150m_qat_2b_run_20261002 --blob-url https://your-storage-account.blob.core.windows.net/runs/terminus_lean_150m_qat_2b_run_20261002/ --vm-resource-id /subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/your-resource-group/providers/Microsoft.Compute/virtualMachines/your-vm --train-service terminus-lean-qat-2b.service --ops-log /var/lib/terminus/ops/qat/finalizer.log --poll-seconds 10
Restart=on-failure
RestartSec=300
StandardOutput=append:/var/lib/terminus/ops/qat/finalizer.log
StandardError=append:/var/lib/terminus/ops/qat/finalizer.log

[Install]
WantedBy=multi-user.target
