[Unit]
Description=Terminus Lean 150M ternary-FP8 QAT continuation on 2B fresh tokens (sanitized template)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/terminus
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=simple
User=terminus
Group=terminus
WorkingDirectory=/opt/terminus-modeltunnelv2
Environment=PYTHON=/opt/terminus-venv/bin/python
Environment=PYTHONPATH=/opt/terminus-modeltunnelv2:/opt/terminus-native/fa3-site
Environment=CUDA_HOME=/usr/local/cuda-13.2
Environment=DG_JIT_CACHE_DIR=/var/cache/terminus/deepgemm-jit
Environment=XDG_CACHE_HOME=/var/cache/terminus
Environment=AWS_DEFAULT_REGION=us-east-1
Environment=DATA_ROOT=/var/lib/terminus/data/packed
Environment=PARENT_ROOT=/var/lib/terminus/runs/lean_dense_10b_20261001
Environment=RUN_ROOT=/var/lib/terminus/runs/lean_ternary_qat_2b_20261002
Environment=S3_RUN_URI=s3://your-run-artifact-bucket/terminus_lean_150m_qat_2b_run_20261002
ExecStart=/bin/bash /opt/terminus-modeltunnelv2/experiments/terminus_lean_150m_qat_2b/launch.sh
Restart=on-failure
RestartSec=30
TimeoutStopSec=300
StandardOutput=append:/var/lib/terminus/runs/lean_ternary_qat_2b_20261002/service.log
StandardError=append:/var/lib/terminus/runs/lean_ternary_qat_2b_20261002/service.log

[Install]
WantedBy=multi-user.target
