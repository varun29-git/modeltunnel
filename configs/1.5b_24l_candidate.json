{
  "model": {
    "vocab_size": 96000,
    "dim": 2304,
    "n_layers": 24,
    "n_heads": 18,
    "n_kv_heads": 6,
    "ffn_dim": 5632,
    "max_seq_len": 4096,
    "local_attention_window": 1024,
    "global_attention_every": 4,
    "attention_backend": "fa3",
    "weight_init": "normal",
    "pad_token_id": 0,
    "gradient_checkpointing": true,
    "loss_chunk_size": 256,
    "residual_init_scale": 0.14433756729740646,
    "quantize_activations": false,
    "weight_scale_layout": "rowwise",
    "linear_backend": "torch"
  },
  "training": {
    "device": "cuda",
    "dtype": "bf16",
    "development_mode": false,
    "gradient_accumulation_steps": 8,
    "warmup_tokens": 300000000,
    "final_lr_fraction": 0.1,
    "grad_clip": 1.0,
    "checkpoint_interval": 500,
    "validation_interval": 500,
    "validation_batches_per_language": 8,
    "log_interval": 10,
    "compile": false
  },
  "optimizer": {
    "kind": "adamw",
    "adamw_lr": 0.0003,
    "norm_lr": 0.0001,
    "weight_decay": 0.1,
    "eps": 1e-08
  }
}
